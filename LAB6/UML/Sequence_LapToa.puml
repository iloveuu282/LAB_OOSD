@startuml
skinparam monochrome true
actor "Bác sĩ" as BS
boundary "FrmToaThuoc" as UI
control "ToaThuocService" as SV
database "SQL Server" as DB
BS -> UI: Chọn phiếu khám
UI -> SV: LayDuLieuKham(id)
SV -> DB: SELECT phiếu khám, xét nghiệm
DB --> SV: Dữ liệu
SV --> UI: Hiển thị
BS -> UI: Nhập thuốc, liều và số lượng
UI -> SV: LapToa(phieu, danhSachThuoc)
SV -> SV: Kiểm tra hợp lệ
alt Hợp lệ
SV -> DB: BEGIN TRAN + INSERT ToaThuoc
SV -> DB: INSERT ChiTietToa
alt Tất cả thành công
SV -> DB: COMMIT
SV --> UI: Mã toa
else Có lỗi
SV -> DB: ROLLBACK
SV --> UI: Thông báo lỗi
end
else Không hợp lệ
SV --> UI: Yêu cầu sửa thông tin
end
@enduml